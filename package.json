{
  "name": "@neuralsearchindex/scraper-provider-sdk",
  "version": "0.1.0",
  "description": "Author one scraper provider as its own standalone app (own Docker image) that joins the distributed catalog over Redis/BullMQ. Contract + minimal engine + runProviderWorker + a create-scraper-provider scaffolder.",
  "type": "commonjs",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "create-scraper-provider": "lib/cli.js"
  },
  "files": [
    "lib",
    "templates"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "prepare": "tsc --project tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "types:check": "tsc --noEmit",
    "test": "NODE_ENV=test TZ=utc tsx --test --test-concurrency=1 \"src/**/*.test.ts\""
  },
  "dependencies": {
    "bullmq": "^5.66.0",
    "cheerio": "^1.2.0",
    "ioredis": "^5.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
