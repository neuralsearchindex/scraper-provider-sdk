# The shared BullMQ Redis the central scraper uses (the ONLY connection this worker needs).
# GOTCHA: use the SAME DB index the central scraper's JOBS_REDIS_URL uses (e.g. /1).
REDIS_URL=redis://localhost:6379/1
# Optional: per-lane concurrency (default 4).
CONCURRENCY=4
# Optional: the running image version to advertise. In k8s, Helm sets this to the image tag;
# locally it falls back to this package.json version.
# CATALOG_VERSION=0.1.0
# Optional: a REMOTE browser (CDP) for JS-heavy sites. Requires `pnpm add playwright-core`
# and a provider with `detailFetchEngine: "browser"`. Leave unset for deterministic providers.
# REMOTE_BROWSER_CDP_URL=http://playwright-vnc:9222

# ---- Error tracking (GlitchTip) -------------------------------------------
# Set by Helm in the cluster (one GlitchTip project per catalog, so the DSN is
# this catalog's own). Leave UNSET locally: an unset DSN disables reporting
# entirely, which is what you want when developing — otherwise every selector
# you break while iterating lands in the production issue stream.
# SENTRY_DSN=https://<key>@glitchtip.<gateway-ip>.nip.io/<project-id>
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0
