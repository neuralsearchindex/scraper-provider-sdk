# The shared BullMQ Redis the central scraper uses (the ONLY connection this worker needs).
REDIS_URL=redis://localhost:6379
# Optional: per-lane concurrency (default 4).
CONCURRENCY=4
# Optional: a REMOTE browser (CDP) for JS-heavy sites. Requires `pnpm add playwright-core`
# and a provider with `detailFetchEngine: "browser"`. Leave unset for deterministic providers.
# REMOTE_BROWSER_CDP_URL=http://playwright-vnc:9222
